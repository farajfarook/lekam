# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp config/lekam.service ~/.config/systemd/user/
#   edit LEKAM_OWNER (and the node path), then: systemctl --user daemon-reload && systemctl --user enable --now lekam
# Secrets (LEKAM_SLACK_BOT_TOKEN, LEKAM_SLACK_APP_TOKEN) come from a root-only env file outside the repo.
[Unit]
Description=Lekam - chat with Paseo agent sessions from a Slack DM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/lekam
Environment=LEKAM_OWNER=U0000000000
Environment=LEKAM_HOSTS=this=ws://127.0.0.1:6767/ws,other=ssh://root@other.internal
ExecStart=/bin/bash -lc '. $HOME/.agents/env.local.sh && exec node --no-warnings %h/lekam/src/main.mjs'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
